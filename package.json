{
  "name": "ape",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deck-pipeline structural checks, .apkg export, and an ACP client.",
  "engines": {
    "node": ">=24.12.0"
  },
  "bin": {
    "ape": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/cli/index.js",
    "typecheck": "npm run build && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && node --test"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "26.4.1"
  }
}
