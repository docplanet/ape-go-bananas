    "app:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
