{
  "name": "ape-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tauri shell over the A.P.E. engine: drop course material in, review cards, get a deck out.",
  "engines": { "node": ">=24.12.0" },
  "scripts": {
    "dev": "vite",
